cat > .gitignore << 'EOF'
# Dependencies
node_modules/
**/node_modules/

# Environment variables
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Build output
build/
dist/
coverage/
frontend/build/

# Runtime / temporary files
*.tmp
*.temp
.cache/
**/.cache/

# OS files
.DS_Store
Thumbs.db

# IDE / editor files
.vscode/
.idea/
*.swp
*.swo

# Test / coverage output
.nyc_output/

# Local databases
*.sqlite
*.sqlite3
*.db

# Temporary files
*.bak
*.orig
*~

# Secrets / credentials
*.pem
*.key
credentials.json
secrets.json

# Not pushing the orchestrator
orchestrator/
EOF